# Local-only overrides; per-environment tfvars under environments/ are committed
/terraform.tfvars

# Local working cache and provider binaries — regenerated by `terraform init`
.terraform/

# Local state and backups; real state now lives in S3
*.tfstate
*.tfstate.*

# Saved plans can contain resolved variable values
*.tfplan
tfplan
bootstrap/tfplan

# account/ is applied locally only; its local values (e.g. the alert email) stay out of this public repo
account/local.auto.tfvars
